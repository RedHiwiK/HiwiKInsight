# Public host name of your server; Caddy gets a certificate for it. DNS must point here.
DOMAIN=insight.example.com

# Secrets referenced from config/config.yaml as ${NAME}

# Dashboard password hash from `hiwikinsight hash-password` (or
# `docker run --rm -it ghcr.io/redhiwik/hiwikinsight hash-password`).
# Keep the single quotes: bcrypt hashes contain "$", which Compose would otherwise interpolate.
HIWIKINSIGHT_ADMIN_HASH='$2a$10$replace.with.your.own.hash'
HIWIKINSIGHT_QUERY_TOKEN=change-me-openssl-rand-hex-32
SMTP_PASSWORD=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_VENDOR_NUMBER=
